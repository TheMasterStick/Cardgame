# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon/publishable
# key is meant to be public — safe to ship in the client bundle. Never put
# the service_role key here or anywhere in client code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
